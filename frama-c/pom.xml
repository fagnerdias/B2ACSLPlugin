<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>b2acsl-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>b2acsl-frama-c</artifactId>
  <name>b2acsl-frama-c</name>
  <description>Invocação do Frama-C (-acsl-import + -wp via FramaCRunner/ExternalVerifierRunner) e
    a cadeia de pós-processamento de merged_code.c (estágios nomeados, AxiomaticTierSorter,
    SpecificationAxiomaticInstantiator, etc.). Depende de b2acsl-core (diálogos/estimador) e
    b2acsl-translate (bxml, resolução de biblioteca).</description>

  <dependencies>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>b2acsl-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>b2acsl-translate</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Jar standalone (classifier "all") para FramaCRunner#verify como entry point reutilizável
           por chamadores externos (outra ferramenta/script) — só os passos acsl-import →
           pós-processamento de merged_code.c → -wp, sem a tradução BXML→ACSL do módulo "cli".
           Empacota as classes deste módulo + b2acsl-core + b2acsl-translate (dependências diretas
           de FramaCRunner); sem mainClass, já que isto é uma biblioteca para chamar via API, não um
           executável. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
