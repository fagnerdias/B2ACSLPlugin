# Compiled class file
*.class

# Log file
*.log

# Maven (projeto multi-módulo: core/translate/frama-c/cli têm cada um o seu próprio target/,
# além do target/ na raiz onde o módulo cli redireciona a build final)
target/*
*/target/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Arquivo de plugin (Atelier B / ETool)
plugin.etool

# SonarQube (análise local via "mvn sonar:sonar")
.scannerwork/
.sonar/

docs/*

examples/

# Logs de execução de scripts/run_examples.sh (histórico local de regressão manual)
scripts/run-logs/
