<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>b2acsl-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>b2acsl-parent</name>
  <description>B2ACSLPlugin: tradutor BXML -> ACSL e pipeline de verificação Frama-C, em 4 módulos
    Maven (core, translate, frama-c, cli) — split de empacotamento a partir do módulo único
    original "xml-reader"; nenhuma lógica de tradução/pipeline foi alterada, só reorganizada.</description>

  <modules>
    <module>core</module>
    <module>translate</module>
    <module>frama-c</module>
    <module>cli</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <b2acsl.mock>false</b2acsl.mock>

    <jackson.version>2.17.2</jackson.version>
    <graalvm.native.plugin.version>0.10.3</graalvm.native.plugin.version>
    <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.antrun.plugin.version>3.1.0</maven.antrun.plugin.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    <junit.jupiter.version>5.10.3</junit.jupiter.version>
    <graalvm.home>${env.GRAALVM_HOME}</graalvm.home>

    <!-- SonarQube: análise local via "mvn sonar:sonar" contra um servidor em
         sonar.host.url (default: instância local na porta padrão do SonarQube).
         Token NÃO fica aqui (segredo) — passar via -Dsonar.token=... na linha de
         comando ou variável de ambiente SONAR_TOKEN. -->
    <sonar.maven.plugin.version>3.11.0.3922</sonar.maven.plugin.version>
    <sonar.projectKey>b2acsl-plugin</sonar.projectKey>
    <sonar.projectName>B2ACSL Plugin</sonar.projectName>
    <sonar.host.url>http://localhost:9000</sonar.host.url>
    <sonar.sources>src/main/java</sonar.sources>
    <sonar.java.source>${maven.compiler.release}</sonar.java.source>
  </properties>

  <!-- Coordenadas dos módulos-irmãos, para cada módulo declarar como <dependency> apenas os
       outros módulos de que realmente precisa (ver árvore de dependências no fim deste ficheiro). -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>b2acsl-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>b2acsl-translate</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example</groupId>
        <artifactId>b2acsl-frama-c</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.fasterxml.jackson.dataformat</groupId>
        <artifactId>jackson-dataformat-xml</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.jupiter.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>

        <!-- JUnit 5 (JUnit Platform) precisa de surefire >= 2.22 para ser detectado
             automaticamente; a versão herdada da super POM do Maven 3.8.x (2.12.4) não
             reconhece o provider da plataforma. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <!-- SonarQube: opt-in, só roda com "mvn sonar:sonar" (sem <executions>, não entra
           no build normal). Precisa de um servidor SonarQube acessível em sonar.host.url
           e um token (-Dsonar.token=... ou variável SONAR_TOKEN). -->
      <plugin>
        <groupId>org.sonarsource.scanner.maven</groupId>
        <artifactId>sonar-maven-plugin</artifactId>
        <version>${sonar.maven.plugin.version}</version>
      </plugin>
    </plugins>
  </build>

  <!--
    Árvore de dependências entre módulos (acíclica — verificada classe a classe antes do split):

      core        (com.example.ui.*, com.example.analysis.*, B2AcslConfig)
        ^               nenhuma dependência de outro módulo B2ACSL
        |
      translate   (com.example.bxml.*, com.example.model.Machine, AcslGenerator,
        ^          AcslLibIncludes, AcslLibSymbolDependencyMap, B2AcslLibraryPaths,
        |          AcslLibraryResolver/DefaultAcslLibraryResolver, BDefinitionsTranslator,
        |          SpecificationTypesCollector) — depende só de core (B2AcslConfig, para as
        |          properties acslLib* de boot lidas por AcslLibIncludes; targetAcslDir deixou de
        |          ser property, passou a parâmetro Path explícito)
        |
      frama-c     (FramaCRunner, ExternalVerifierRunner/FramaCVerifierRunner,
        ^          GhostMergedCodeCleanup + stages de merged_code.c, AxiomaticTierSorter e
        |          demais passes de pós-processamento, AnySubMarkerSpec)
        |          depende de core (ui/analysis) e de translate (bxml, AcslLibraryResolver)
        |
      cli         (Main, B2ACSLPipeline) — depende de core, translate e frama-c

    Achado do split: havia uma dependência circular real entre o pacote raiz com.example e
    com.example.bxml (algumas classes de bxml importavam AcslGenerator/AcslLibIncludes/etc.,
    enquanto quase todo o pacote raiz depende de bxml) — por isso "core"/"translate" acima não
    corresponde 1:1 à nomeação ilustrativa original ("core, translate, frama-c, cli"): as classes
    de resolução de biblioteca ACSL (AcslLibIncludes, AcslLibSymbolDependencyMap,
    B2AcslLibraryPaths) foram ao módulo "translate" (não um "core" separado), porque é exatamente
    esse quem as consome de dentro do pacote bxml. Duas referências reais (não-javadoc) do módulo
    frama-c ao módulo cli também foram corrigidas como parte do split:
    FramaCRunner.MERGED_CODE_FILE_NAME (movida de B2ACSLPipeline) e o anchor de classloader em
    LemmaLibraryFilter (trocado de B2ACSLPipeline.class para LemmaLibraryFilter.class) — mesmo
    valor/comportamento, só a classe usada como âncora do getResourceAsStream muda.
  -->
</project>
